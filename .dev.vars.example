TOKEN_ENCRYPTION_KEY=
CHECKIN_PEPPER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict the Google Drive connection to the event's Google account.
GOOGLE_OWNER_EMAIL=
