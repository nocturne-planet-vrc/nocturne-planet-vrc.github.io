# Copy to .dev.vars for LOCAL development only. Never commit actual secrets.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Generate 32 random bytes, base64 encoded. Store as a Worker secret in production.
TOKEN_ENCRYPTION_KEY=
CHECKIN_PEPPER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict the Google Drive connection to the event's Google account.
GOOGLE_OWNER_EMAIL=
# Event-owned VRChat verification account ONLY. Never collect visitors' login tokens.
# Optional; linking stays unavailable until the dedicated account is connected.
VRCHAT_AUTH_TOKEN=
VRCHAT_TWO_FACTOR_TOKEN=
# Optional: bot of the "Nocturne Planet Web" app, added to the staff server with
# Server Members Intent enabled. Used only to read the staff member list and roles.
DISCORD_BOT_TOKEN=
